    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_38_2013_TT_BLDTBXH ;
    vlpd:contentText "Quy chuẩn kỹ thuật quốc gia về an toàn lao động đối với với ống cách điện có chứa bọt và sào cách điện dạng đặc dùng để làm việc khi có điện có hiệu lực từ ngày 28 tháng 6 năm 2014."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_11_2_https_example_org_vn_legal_instance_Doc_Circular_38_2013_TT_BLDTBXH ;
    vlpd:heading "Điều 20.5.TT.11.2."@vi .

