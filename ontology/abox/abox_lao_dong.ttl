    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_43_2_https_example_org_vn_legal_instance_Doc_Circular_128_2016_TT_BQP ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_43_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.43.3: Trách nhiệm thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.43.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_128_2016_TT_BQP ;
    vlpd:contentText "Chủ nhiệm Tổng cục Kỹ thuật, Thủ trưởng các cơ quan, đơn vị liên quan chịu trách nhiệm thi hành Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_43_3_https_example_org_vn_legal_instance_Doc_Circular_128_2016_TT_BQP ;
    vlpd:heading "Trách nhiệm thi hành"@vi .

inst:Article_20_5_TT_44_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.44.2: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.44.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_49_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Tổ chức, cá nhân sản xuất, nhập khẩu, cung cấp, sử dụng phương tiện bảo vệ mắt cá nhân dùng trong công việc hàn có trách nhiệm thực hiện quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
2. Các tổ chức thực hiện chứng nhận hợp quy đối với phương tiện bảo vệ mắt cá nhân dùng trong công việc hàn phải tuân theo các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
3. Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Ủy ban nhân dân các tỉnh, thành phố trực thuộc Trung ương và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_44_2_https_example_org_vn_legal_instance_Doc_Circular_49_2016_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_44_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.44.3: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.44.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_49_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Thông tư này có hiệu lực kể từ ngày 01 tháng 8 năm 2017.
2. Trong quá trình thực hiện, nếu có vướng mắc đề nghị phản ánh về Bộ Lao động - Thương binh và Xã hội để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_44_3_https_example_org_vn_legal_instance_Doc_Circular_49_2016_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_45_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.45.2: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.45.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_50_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Tổ chức, cá nhân sản xuất, nhập khẩu, cung cấp, sử dụng bộ lọc tự động dùng trong mặt nạ hàn có trách nhiệm thực hiện đúng các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
2. Các tổ chức thực hiện chứng nhận hợp quy đối với bộ lọc tự động dùng trong mặt nạ hàn phải tuân theo các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
3. Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Ủy ban nhân dân các tỉnh, thành phố trực thuộc Trung ương và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_45_2_https_example_org_vn_legal_instance_Doc_Circular_50_2016_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_45_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.45.3: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.45.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_50_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Thông tư này có hiệu lực kể từ ngày 01 tháng 8 năm 2017.
2. Trong quá trình thực hiện, nếu có vướng mắc đề nghị phản ánh về Bộ Lao động - Thương binh và Xã hội để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_45_3_https_example_org_vn_legal_instance_Doc_Circular_50_2016_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_46_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.46.2: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.46.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_51_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Tổ chức, cá nhân sản xuất, nhập khẩu, cung cấp, sử dụng, sửa chữa cần trục có trách nhiệm thực hiện quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
2. Tổ chức thực hiện việc kiểm định, chứng nhận hợp quy đối với cần trục phải tuân theo các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
3. Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Ủy ban nhân dân các tỉnh, thành phố trực thuộc Trung ương và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_46_2_https_example_org_vn_legal_instance_Doc_Circular_51_2016_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_46_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.46.3: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.46.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_51_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Thông tư này có hiệu lực kể từ ngày 01 tháng 08 năm 2017.
2. Trong quá trình thực hiện, nếu có vướng mắc đề nghị phản ánh về Bộ Lao động - Thương binh và Xã hội để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_46_3_https_example_org_vn_legal_instance_Doc_Circular_51_2016_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_47_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.47.2: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.47.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_52_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Các tổ chức cá nhân sản xuất, nhập khẩu, cung cấp, sử dụng, sửa chữa cầu trục, cổng trục có trách nhiệm thực hiện đúng các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
2. Các tổ chức thực hiện việc kiểm định, chứng nhận hợp quy đối với cầu trục, cổng trục phải tuân theo các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
3. Các Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Ủy ban nhân dân các tỉnh, thành phố trực thuộc Trung ương và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_47_2_https_example_org_vn_legal_instance_Doc_Circular_52_2016_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_47_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.47.3: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.47.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_52_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Thông tư này có hiệu lực kể từ ngày 01 tháng 8 năm 2017.
2. Trong quá trình thực hiện, nếu có vướng mắc đề nghị phản ánh về Bộ Lao động - Thương binh và Xã hội để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_47_3_https_example_org_vn_legal_instance_Doc_Circular_52_2016_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_48_1 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.48.1: Phạm vi điều chỉnh và đối tượng áp dụng"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.48.1"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_1_https_example_org_vn_legal_instance_Doc_Circular_54_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Ban hành kèm theo Thông tư này 30 quy trình kiểm định kỹ thuật an toàn đối với máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Lao động - Thương binh và Xã hội. Tên và ký hiệu của các quy trình được nêu tại Phụ lục Thông tư này.
2. Thông tư này áp dụng đối với các tổ chức hoạt động kiểm định kỹ thuật an toàn lao động, kiểm định viên kiểm định kỹ thuật an toàn lao động thực hiện kiểm định kỹ thuật an toàn lao động đối với các máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Lao động - Thương binh và Xã hội.
Quy trinh kiem dinh_ban hanh kem theo TT so 54.2019.TT-BLĐTBXH.doc"""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_48_1_https_example_org_vn_legal_instance_Doc_Circular_54_2016_TT_BLDTBXH ;
    vlpd:heading "Phạm vi điều chỉnh và đối tượng áp dụng"@vi .

inst:Article_20_5_TT_48_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.48.2: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.48.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_54_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Thông tư này có hiệu lực thi hành kể từ ngày 01 tháng 6 năm 2017.
2. Bãi bỏ Thông tư số 07/2014/TT-BLĐTBXH ngày 06 tháng 3 năm 2014 của Bộ Lao động - Thương binh và Xã hội ban hành 27 quy trình kiểm định kỹ thuật an toàn đối với máy, thiết bị có yêu cầu nghiêm ngặt về an toàn lao động thuộc trách nhiệm quản lý của Bộ Lao động - Thương binh và Xã hội và Thông tư số 46/2015/TT-BLĐTBXH ngày 16 tháng 11 năm 2015 của Bộ Lao động - Thương binh và Xã hội ban hành các quy trình kiểm định kỹ thuật an toàn đối với xe tời điện chạy trên ray; pa lăng xích kéo tay có tải trọng từ 1.000kg trở lên; trục tải giếng đứng; trục tải giếng nghiêng; sàn biểu diễn di động và nồi gia nhiệt dầu."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_48_2_https_example_org_vn_legal_instance_Doc_Circular_54_2016_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_48_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.48.3: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.48.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_54_2016_TT_BLDTBXH ;
    vlpd:contentText """1. Cục An toàn lao động, Bộ Lao động - Thương binh và Xã hội, các tổ chức kiểm định kỹ thuật an toàn lao động và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này.
2. Trong quá trình thực hiện nếu có vướng mắc, đề nghị các cơ quan, tổ chức, cá nhân phản ánh về Bộ Lao động - Thương binh và Xã hội để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_48_3_https_example_org_vn_legal_instance_Doc_Circular_54_2016_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_49_4 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.49.4: Điều 20.5.TT.49.4."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.49.4"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_4_https_example_org_vn_legal_instance_Doc_Circular_29_2016_TT_BXD ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành kể từ ngày 15 tháng 2 năm 2017."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_49_4_https_example_org_vn_legal_instance_Doc_Circular_29_2016_TT_BXD ;
    vlpd:heading "Điều 20.5.TT.49.4."@vi .

inst:Article_20_5_TT_49_5 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.49.5: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.49.5"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_5_https_example_org_vn_legal_instance_Doc_Circular_29_2016_TT_BXD ;
    vlpd:contentText """1. Cục Giám định nhà nước về chất lượng công trình xây dựng có trách nhiệm tổ chức thực hiện Thông tư này; tổng hợp, báo cáo Bộ Xây dựng các ý kiến đề xuất sửa đổi, bổ sung đối với từng quy trình kiểm định kỹ thuật an toàn để phù hợp với trình độ phát triển công nghệ của các máy, thiết bị có yêu cầu nghiêm ngặt về an toàn lao động thuộc phạm vi quản lý của Bộ Xây dựng.
2. Các tổ chức hoạt động kiểm định kỹ thuật an toàn lao động và các doanh nghiệp, cơ quan, tổ chức, cá nhân sở hữu, quản lý, sử dụng cần trục tháp, máy vận thăng và sàn treo nâng người sử dụng trong thi công xây dựng chịu trách nhiệm thi hành Thông tư này. Trong quá trình thực hiện nếu có vướng mắc, đề nghị các cơ quan, tổ chức, cá nhân phản ánh về Bộ Xây dựng để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_49_5_https_example_org_vn_legal_instance_Doc_Circular_29_2016_TT_BXD ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_4_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.4.2: Điều 20.5.TT.4.2."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.4.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_05_2012_TT_BLDTBXH ;
    vlpd:contentText "Quy chuẩn kỹ thuật quốc gia về an toàn lao động đối với thiết bị nâng có hiệu lực sau 06 tháng kể từ ngày ký Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_4_2_https_example_org_vn_legal_instance_Doc_Circular_05_2012_TT_BLDTBXH ;
    vlpd:heading "Điều 20.5.TT.4.2."@vi .

inst:Article_20_5_TT_4_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.4.3: Điều 20.5.TT.4.3."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.4.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_05_2012_TT_BLDTBXH ;
    vlpd:contentText "Các Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Ủy ban nhân dân các tỉnh, thành phố trực thuộc Trung ương và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_4_3_https_example_org_vn_legal_instance_Doc_Circular_05_2012_TT_BLDTBXH ;
    vlpd:heading "Điều 20.5.TT.4.3."@vi .

inst:Article_20_5_TT_50_1 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.50.1: Phạm vi điều chỉnh"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.50.1"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_1_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:contentText "Thông tư này quy định việc khai báo, điều tra, thống kê và báo cáo tai nạn lao động trong Bộ Quốc phòng."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_50_1_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:heading "Phạm vi điều chỉnh"@vi .

inst:Article_20_5_TT_50_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.50.2: Đối tượng áp dụng"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.50.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:contentText """1. Các cơ quan, đơn vị, doanh nghiệp, đơn vị hành chính sự nghiệp công lập, các tổ chức đoàn thể trong Bộ Quốc phòng làm nhiệm vụ đào tạo, huấn luyện, thường trực sẵn sàng chiến đấu khi làm nhiệm vụ lao động sản xuất, kinh doanh có sử dụng lao động (sau đây gọi chung là người sử dụng lao động), bao gồm:
2. Quân nhân, công nhân và viên chức quốc phòng, người lao động làm việc theo chế độ hợp đồng, kể cả dân quân tự vệ, dự bị động viên khi làm nhiệm vụ quốc phòng, an ninh (sau đây gọi chung là người lao động)."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_50_2_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:heading "Đối tượng áp dụng"@vi .

inst:Article_20_5_TT_50_20 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.50.20: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.50.20"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_20_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành từ ngày 20 tháng 02 năm 2017 và thay thế Thông tư số 147/2012/TT-BQP ngày 27 tháng 12 năm 2012 của Bộ trưởng Bộ Quốc phòng Quy định việc khai báo, điều tra, thống kê và báo cáo tai nạn lao động trong Quân đội."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_50_20_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_50_21 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.50.21: Trách nhiệm thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.50.21"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_21_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:contentText """1. Chủ nhiệm Tổng cục Kỹ thuật, Thủ trưởng các cơ quan đơn vị, tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này.
2. Chủ nhiệm Tổng cục Kỹ thuật chủ trì, phối hợp với các cơ quan có liên quan tổ chức triển khai thực hiện và theo dõi, kiểm tra, nắm tình hình, nếu có vướng mắc, kịp thời báo cáo Thủ trưởng Bộ Quốc phòng."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_50_21_https_example_org_vn_legal_instance_Doc_Circular_01_2017_TT_BQP ;
    vlpd:heading "Trách nhiệm thi hành"@vi .

inst:Article_20_5_TT_51_1 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.51.1: Phạm vi điều chỉnh"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.51.1"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_1_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:contentText "Thông tư này quy định về kiểm định kỹ thuật an toàn lao động; điều kiện, tiêu chuẩn cấp giấy chứng nhận đủ điều kiện hoạt động kiểm định kỹ thuật an toàn lao động, kiểm định viên và trách nhiệm của các cơ quan, đơn vị."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_51_1_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:heading "Phạm vi điều chỉnh"@vi .

inst:Article_20_5_TT_51_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.51.2: Đối tượng áp dụng"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.51.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:contentText "Thông tư này áp dụng đối với Trung tâm Kiểm định kỹ thuật an toàn quân đội; kiểm định viên và Các cơ quan, đơn vị, tổ chức và cá nhân có liên quan."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_51_2_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:heading "Đối tượng áp dụng"@vi .

inst:Article_20_5_TT_51_24 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.51.24: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.51.24"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_24_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành kể từ ngày 22 tháng 02 năm 2017 và thay thế Thông tư số 142/2014/TT-BQP ngày 22 tháng 10 năm 2014 của Bộ Quốc phòng quy định công tác kiểm định kỹ thuật an toàn máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động trong Bộ Quốc phòng."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_51_24_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_51_25 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.51.25: Trách nhiệm thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.51.25"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_25_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:contentText "Chủ nhiệm Tổng cục Kỹ thuật và Thủ trưởng các cơ quan, đơn vị trong toàn quân và các tổ chức, cơ quan có liên quan chịu trách nhiệm thi hành Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_51_25_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:heading "Trách nhiệm thi hành"@vi .

inst:Article_20_5_TT_51_26 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.51.26: Trách nhiệm tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.51.26"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_137_2021_TT_BQP ;
    vlpd:contentText "Chủ nhiệm Tổng cục Kỹ thuật, Thủ trưởng các cơ quan, đơn vị, tổ chức và cá nhân liên quan chịu trách nhiệm thi hành Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_51_26_https_example_org_vn_legal_instance_Doc_Circular_137_2021_TT_BQP ;
    vlpd:heading "Trách nhiệm tổ chức thực hiện"@vi .

inst:Article_20_5_TT_51_27 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.51.27: Điều khoản thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.51.27"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_4_https_example_org_vn_legal_instance_Doc_Circular_137_2021_TT_BQP ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành từ ngày 06 tháng 12 năm 2021."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_51_27_https_example_org_vn_legal_instance_Doc_Circular_137_2021_TT_BQP ;
    vlpd:heading "Điều khoản thi hành"@vi .

inst:Article_20_5_TT_51_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.51.3: Giải thích từ ngữ"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.51.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:contentText """1. Kiểm định viên là người được cơ quan có thẩm quyền cấp chứng chỉ kiểm định viên kỹ thuật an toàn lao động (sau đây viết gọn là chứng chỉ kiểm định viên); trực tiếp thực hiện hoặc chỉ đạo, giám sát kỹ thuật viên về thực hiện việc kiểm định kỹ thuật an toàn máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động.
2. Đối tượng kiểm định là máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc trách nhiệm quản lý của Bộ Quốc phòng được quy định tại Phụ lục II ban hành kèm theo Thông tư này.
3. Kiểm định kỹ thuật an toàn lao động (sau đây viết gọn là kiểm định) là hoạt động theo quy trình kiểm định kỹ thuật an toàn lao động, nhằm đánh giá và xác nhận sự phù hợp tình trạng kỹ thuật an toàn của đối tượng kiểm định được quy định trong các quy chuẩn kỹ thuật hoặc tiêu chuẩn kỹ thuật tương ứng đối với đối tượng kiểm định.
4. Đơn vị kiểm định kỹ thuật an toàn lao động (sau đây viết gọn là đơn vị kiểm định) là đơn vị có đủ các điều kiện theo quy định của Nhà nước và Bộ Quốc phòng về hoạt động kiểm định kỹ thuật an toàn máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_51_3_https_example_org_vn_legal_instance_Doc_Circular_08_2017_TT_BQP ;
    vlpd:heading "Giải thích từ ngữ"@vi .

inst:Article_20_5_TT_52_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.52.2: Điều 20.5.TT.52.2."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.52.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BQP ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành kể từ ngày 10 tháng 3 năm 2017 và được áp dụng thống nhất trong toàn quốc."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_52_2_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BQP ;
    vlpd:heading "Điều 20.5.TT.52.2."@vi .

inst:Article_20_5_TT_52_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.52.3: Điều 20.5.TT.52.3."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.52.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BQP ;
    vlpd:contentText "Cục trưởng Cục Tiêu chuẩn - Đo lường - Chất lượng, Thủ trưởng các cơ quan, đơn vị và cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_52_3_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BQP ;
    vlpd:heading "Điều 20.5.TT.52.3."@vi .

inst:Article_20_5_TT_53_1 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.53.1: Phạm vi điều chỉnh"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.53.1"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_1_https_example_org_vn_legal_instance_Doc_Circular_16_2017_TT_BLDTBXH ;
    vlpd:contentText "Thông tư này quy định một số biện pháp quản lý, triển khai hoạt động kiểm định kỹ thuật an toàn lao động; hình thức, nội dung, chương trình và việc tổ chức thực hiện huấn luyện, bồi dưỡng, sát hạch nghiệp vụ kiểm định máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc trách nhiệm quản lý của Bộ Lao động - Thương binh và Xã hội; ứng dụng công nghệ thông tin trong hoạt động kiểm định kỹ thuật an toàn lao động."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_53_1_https_example_org_vn_legal_instance_Doc_Circular_16_2017_TT_BLDTBXH ;
    vlpd:heading "Phạm vi điều chỉnh"@vi .

inst:Article_20_5_TT_53_18 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.53.18: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.53.18"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_18_https_example_org_vn_legal_instance_Doc_Circular_16_2017_TT_BLDTBXH ;
    vlpd:contentText """1. Thông tư này có hiệu lực kể từ ngày 22 tháng 8 năm 2017.
2. Trong quá trình thực hiện Thông tư này, nếu có vướng mắc, đề nghị các cá nhân, tổ chức phản ánh về Bộ Lao động - Thương binh và Xã hội để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_53_18_https_example_org_vn_legal_instance_Doc_Circular_16_2017_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_53_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.53.2: Đối tượng áp dụng"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.53.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_16_2017_TT_BLDTBXH ;
    vlpd:contentText """1. Tổ chức kiểm định kỹ thuật an toàn lao động;
2. Kiểm định viên thực hiện kiểm định các máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Lao động - Thương binh và Xã hội;
3. Tổ chức, cá nhân sử dụng các loại máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động;
4. Tổ chức, cá nhân khác có liên quan đến hoạt động kiểm định kỹ thuật an toàn lao động; tổ chức cá nhân huấn luyện, bồi dưỡng, sát hạch nghiệp vụ kiểm định kỹ thuật an toàn lao động thuộc thẩm quyền quản lý của Bộ Lao động - Thương binh và Xã hội."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_53_2_https_example_org_vn_legal_instance_Doc_Circular_16_2017_TT_BLDTBXH ;
    vlpd:heading "Đối tượng áp dụng"@vi .

inst:Article_20_5_TT_54_1 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.54.1: Phạm vi điều chỉnh"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.54.1"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_1_https_example_org_vn_legal_instance_Doc_Circular_09_2017_TT_BCT ;
    vlpd:contentText "Thông tư này quy định về hoạt động kiểm định kỹ thuật an toàn lao động máy, thiết bị, vật tư trong Danh mục máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động do Bộ Lao động - Thương binh và Xã hội ban hành thuộc thẩm quyền quản lý của Bộ Công Thương theo quy định tại Phụ lục Ib Nghị định số 44/2016/NĐ-CP ngày 15 tháng 5 năm 2016 của Chính phủ quy định chi tiết một số điều của Luật An toàn, vệ sinh lao động về hoạt động kiểm định kỹ thuật an toàn lao động, huấn luyện an toàn, vệ sinh lao động và quan trắc môi trường lao động (Nghị định 44/2016/NĐ-CP)."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_54_1_https_example_org_vn_legal_instance_Doc_Circular_09_2017_TT_BCT ;
    vlpd:heading "Phạm vi điều chỉnh"@vi .

inst:Article_20_5_TT_54_19 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.54.19: Điều khoản thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.54.19"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_19_https_example_org_vn_legal_instance_Doc_Circular_09_2017_TT_BCT ;
    vlpd:contentText """1. Thông tư này có hiệu lực thi hành kể từ ngày 31 tháng 8 năm 2017 và bãi bỏ Thông tư số 35/2009/TT-BCT ngày 09 tháng 12 năm 2009 của Bộ Công Thương quy định về điều kiện hoạt động đối với các tổ chức kiểm định kỹ thuật an toàn.
2. Các Tổ chức kiểm định chỉ thực hiện kiểm định máy, thiết bị có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Công Thương sau khi có Giấy chứng nhận đủ điều kiện kiểm định kỹ thuật an toàn lao động.
Các tổ chức kiểm định đã được cấp Giấy chứng nhận đủ điều kiện trước ngày 01 tháng 7 năm 2016 được tiếp tục sử dụng đến hết thời hạn ghi trên Giấy chứng nhận đủ điều kiện đó.
3. Trường hợp có sự thay đổi đối với các văn bản quy phạm pháp luật, tiêu chuẩn, quy chuẩn kỹ thuật quốc gia thì áp dụng theo văn bản mới.
4. Trong quá trình thực hiện, nếu có vấn đề phát sinh hoặc vướng mắc, các tổ chức, cá nhân phản ánh về Bộ Công Thương để kịp thời xem xét, giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_54_19_https_example_org_vn_legal_instance_Doc_Circular_09_2017_TT_BCT ;
    vlpd:heading "Điều khoản thi hành"@vi .

inst:Article_20_5_TT_54_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.54.2: Đối tượng áp dụng"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.54.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_09_2017_TT_BCT ;
    vlpd:contentText """1. Tổ chức, cá nhân liên quan đến hoạt động kiểm định máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Công Thương.
2. Tổ chức, cá nhân liên quan đến quản lý, sở hữu và sử dụng máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Công Thương."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_54_2_https_example_org_vn_legal_instance_Doc_Circular_09_2017_TT_BCT ;
    vlpd:heading "Đối tượng áp dụng"@vi .

inst:Article_20_5_TT_54_20 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.54.20: Điều khoản thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.54.20"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_12_2020_TT_BCT ;
    vlpd:contentText """1. Thông tư này có hiệu lực thi hành kể từ ngày 02 tháng 8 năm 2020.
2. Trong quá trình thực hiện, nếu có vấn đề phát sinh hoặc vướng mắc, các tổ chức, cá nhân phản ánh về Bộ Công Thương để kịp thời xem xét, giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_54_20_https_example_org_vn_legal_instance_Doc_Circular_12_2020_TT_BCT ;
    vlpd:heading "Điều khoản thi hành"@vi .

inst:Article_20_5_TT_55_1 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.55.1: Phạm vi điều chỉnh và đối tượng áp dụng"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.55.1"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_1_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BCT ;
    vlpd:contentText """1. Ban hành kèm theo Thông tư này 18 Quy trình kiểm định kỹ thuật an toàn lao động đối với máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Công Thương (Quy trình kiểm định). Tên và ký hiệu các Quy trình kiểm định được nêu tại Phụ lục của Thông tư này.
2. Thông tư này áp dụng đối với các tổ chức, cá nhân liên quan đến hoạt động kiểm định, quản lý, sở hữu và sử dụng máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Công Thương."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_55_1_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BCT ;
    vlpd:heading "Phạm vi điều chỉnh và đối tượng áp dụng"@vi .

inst:Article_20_5_TT_55_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.55.2: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.55.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BCT ;
    vlpd:contentText """1. Thông tư này có hiệu lực thi hành kể từ ngày 15 tháng 9 năm 2017.
2. Máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Công Thương đã được kiểm định trước ngày Thông tư này có hiệu lực tiếp tục có hiệu lực đến hết thời hạn ghi trên Giấy chứng nhận kết quả kiểm định. Đến thời hạn tiếp theo phải do tổ chức kiểm định đã được Bộ Công Thương cấp Giấy chứng nhận đủ điều kiện kiểm định thực hiện.
3. Đối với máy, thiết bị thuộc dây chuyền đang vận hành không thể tách rời kiểm định riêng thì thời hạn kiểm định định kỳ theo chu kỳ bảo dưỡng, sửa chữa của dây chuyền nhưng không quá thời hạn quy định của nhà sản xuất hoặc quy chuẩn kỹ thuật quốc gia tương ứng. Các tổ chức, cá nhân quản lý, sử dụng phải duy trì và chịu trách nhiệm về điều kiện làm việc an toàn cho máy, thiết bị."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_55_2_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BCT ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_55_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.55.3: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.55.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BCT ;
    vlpd:contentText """1. Cục Kỹ thuật an toàn và Môi trường công nghiệp có trách nhiệm hướng dẫn, tổ chức thực hiện Thông tư này.
2. Tổ chức kiểm định kỹ thuật an toàn lao động phải xây dựng Quy trình kiểm định chi tiết cho từng loại máy, thiết bị cụ thể nhưng không được trái với Quy trình kiểm định và quy chuẩn kỹ thuật quốc gia tương ứng.
3. Kiểm định viên phải thực hiện đúng và đủ quy định tại Quy trình kiểm định chi tiết của từng loại máy, thiết bị cụ thể.
4. Tổ chức, cá nhân liên quan đến hoạt động kiểm định, quản lý, sở hữu, sử dụng máy, thiết bị, vật tư có yêu cầu nghiêm ngặt về an toàn lao động thuộc thẩm quyền quản lý của Bộ Công Thương chịu trách nhiệm thi hành Thông tư này.
5. Trong quá trình thực hiện nếu có vướng mắc, đề nghị phản ánh về Bộ Công Thương để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_55_3_https_example_org_vn_legal_instance_Doc_Circular_10_2017_TT_BCT ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_56_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.56.2: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.56.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_20_2017_TT_BLDTBXH ;
    vlpd:contentText """1. Các tổ chức cá nhân sản xuất, nhập khẩu, cung cấp, sử dụng, sửa chữa Đường ống dẫn hơi nước và nước nóng có trách nhiệm thực hiện đúng các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
2. Các tổ chức thực hiện việc kiểm định, chứng nhận hợp quy đối với Đường ống dẫn hơi nước và nước nóng phải tuân theo các quy định tại Quy chuẩn ban hành kèm theo Thông tư này.
3. Các Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Ủy ban nhân dân các tỉnh, thành phố trực thuộc Trung ương và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_56_2_https_example_org_vn_legal_instance_Doc_Circular_20_2017_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_56_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.56.3: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.56.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_20_2017_TT_BLDTBXH ;
    vlpd:contentText """1. Thông tư này có hiệu lực kể từ ngày 11 tháng 9 năm 2017.
2. Trong quá trình thực hiện, nếu có vướng mắc đề nghị phản ánh về Bộ Lao động - Thương binh và Xã hội để nghiên cứu giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_56_3_https_example_org_vn_legal_instance_Doc_Circular_20_2017_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_57_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.57.2: Điều 20.5.TT.57.2."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.57.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_184_2017_TT_BQP ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành kể từ ngày 25 tháng 9 năm 2017 và được áp dụng thống nhất trong toàn quốc"@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_57_2_https_example_org_vn_legal_instance_Doc_Circular_184_2017_TT_BQP ;
    vlpd:heading "Điều 20.5.TT.57.2."@vi .

inst:Article_20_5_TT_57_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.57.3: Điều 20.5.TT.57.3."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.57.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_184_2017_TT_BQP ;
    vlpd:contentText "Cục trưởng Cục Tiêu chuẩn - Đo lường - Chất lượng, Thủ trưởng các cơ quan, đơn vị và cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_57_3_https_example_org_vn_legal_instance_Doc_Circular_184_2017_TT_BQP ;
    vlpd:heading "Điều 20.5.TT.57.3."@vi .

inst:Article_20_5_TT_58_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.58.2: Điều 20.5.TT.58.2."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.58.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_185_2017_TT_BQP ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành kể từ ngày 25 tháng 9 năm 2017 và được áp dụng thống nhất trong toàn quốc."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_58_2_https_example_org_vn_legal_instance_Doc_Circular_185_2017_TT_BQP ;
    vlpd:heading "Điều 20.5.TT.58.2."@vi .

inst:Article_20_5_TT_58_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.58.3: Điều 20.5.TT.58.3."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.58.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_185_2017_TT_BQP ;
    vlpd:contentText "Cục trưởng Cục Tiêu chuẩn - Đo lường - Chất lượng, Thủ trưởng các cơ quan, đơn vị và cá nhân có liên quan chịu trách nhiệm thi hành Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_58_3_https_example_org_vn_legal_instance_Doc_Circular_185_2017_TT_BQP ;
    vlpd:heading "Điều 20.5.TT.58.3."@vi .

inst:Article_20_5_TT_59_1 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.59.1: Phạm vi điều chỉnh"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.59.1"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_1_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:contentText "Thông tư này quy định chi tiết một số nội dung về an toàn, vệ sinh lao động đối với người lao động làm việc trong lĩnh vực nghệ thuật, thể dục thể thao."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_59_1_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:heading "Phạm vi điều chỉnh"@vi .

inst:Article_20_5_TT_59_11 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.59.11: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.59.11"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_11_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:contentText """1. Vụ Pháp chế chủ trì, phối hợp với Vụ Tổ chức cán bộ và các cơ quan, đơn vị có liên quan hướng dẫn, tổ chức kiểm tra việc thực hiện Thông tư này.
2. Sở Văn hóa, Thể thao và Du lịch, Sở Văn hóa và Thể thao các tỉnh, thành phố trực thuộc Trung ương có trách nhiệm tổ chức triển khai thực hiện, kiểm tra, đôn đốc các cơ quan, tổ chức, cá nhân có liên quan thực hiện Thông tư này."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_59_11_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:heading "Tổ chức thực hiện"@vi .

inst:Article_20_5_TT_59_12 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.59.12: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.59.12"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_12_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:contentText """1. Thông tư này có hiệu lực thi hành kể từ ngày 01 tháng 10 năm 2017.
2. Trong quá trình thực hiện, nếu phát sinh vướng mắc, đề nghị các cơ quan, đơn vị, cá nhân kịp thời phản ánh về Bộ Văn hóa, Thể thao và Du lịch (qua Vụ Pháp chế) để nghiên cứu sửa đổi, bổ sung cho phù hợp."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_59_12_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_59_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.59.2: Đối tượng áp dụng"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.59.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:contentText """1. Cơ quan, tổ chức, cá nhân có sử dụng lao động làm việc trong lĩnh vực nghệ thuật, thể dục thể thao (sau đây gọi là người sử dụng lao động).
2. Người lao động làm việc trong lĩnh vực nghệ thuật, thể dục thể thao.
3. Cơ quan, tổ chức, cá nhân có liên quan."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_59_2_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:heading "Đối tượng áp dụng"@vi .

inst:Article_20_5_TT_59_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.59.3: Giải thích từ ngữ"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.59.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:contentText """Trong Thông tư này, những từ ngữ dưới đây được hiểu như sau:
1. Người lao động làm việc trong lĩnh vực nghệ thuật là diễn viên, đạo diễn và người lao động khác tham gia sáng tạo nghệ thuật.
2. Người lao động làm việc trong lĩnh vực thể dục thể thao là huấn luyện viên, vận động viên, hướng dẫn viên thể thao."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_59_3_https_example_org_vn_legal_instance_Doc_Circular_03_2017_TT_BVHTTDL ;
    vlpd:heading "Giải thích từ ngữ"@vi .

inst:Article_20_5_TT_5_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.5.2: Điều 20.5.TT.5.2."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.5.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_07_2012_TT_BLDTBXH ;
    vlpd:contentText "Quy chuẩn kỹ thuật quốc gia về những thiết bị bảo vệ đường hô hấp – Bộ lọc bụi có hiệu lực sau 06 tháng kể từ ngày ký Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_5_2_https_example_org_vn_legal_instance_Doc_Circular_07_2012_TT_BLDTBXH ;
    vlpd:heading "Điều 20.5.TT.5.2."@vi .

inst:Article_20_5_TT_5_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.5.3: Điều 20.5.TT.5.3."@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.5.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_07_2012_TT_BLDTBXH ;
    vlpd:contentText "Các Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Ủy ban nhân dân các tỉnh, thành phố trực thuộc Trung ương và các tổ chức, cá nhân có liên quan chịu trách nhiệm thi hành."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_5_3_https_example_org_vn_legal_instance_Doc_Circular_07_2012_TT_BLDTBXH ;
    vlpd:heading "Điều 20.5.TT.5.3."@vi .

inst:Article_20_5_TT_60_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.60.2: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.60.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_197_2017_TT_BQP ;
    vlpd:contentText "Thông tư này có hiệu lực thi hành kể từ ngày 08 tháng 10 năm 2017."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_60_2_https_example_org_vn_legal_instance_Doc_Circular_197_2017_TT_BQP ;
