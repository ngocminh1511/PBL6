inst:Article_20_2_ND_6_4 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.2.NĐ.6.4: Chính sách đối với người lao động dôi dư được tuyển dụng lần cuối cùng từ ngày 21 tháng 4 năm 1998 hoặc từ ngày 26 tháng 4 năm 2002 trở về sau"@vi ;
    vlpd:belongsToItem inst:Item_20_2 ;
    vlpd:codificationNumber "20.2.NĐ.6.4"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_4_https_example_org_vn_legal_instance_Doc_Decree_97_2022_ND_CP ;
    vlpd:contentText """Người lao động dôi dư quy định tại điểm c và d khoản 1 Điều 2 Nghị định này được hưởng chính sách như sau:
1. Trợ cấp mất việc làm quy định tại Điều 47 Bộ luật Lao động và khoản 2 Điều 8 Nghị định số 145/2020/NĐ-CP đối với người lao động trong doanh nghiệp thực hiện sắp xếp lại theo quy định tại khoản 1, 2, 3 và 4 Điều 1 Nghị định này.
2. Trợ cấp thôi việc quy định tại Điều 46 Bộ luật Lao động và khoản 1 Điều 8 Nghị định số 145/2020/NĐ-CP đối với người lao động trong doanh nghiệp thực hiện sắp xếp lại theo quy định tại khoản 5 Điều 1 Nghị định này."""@vi ;
    vlpd:hasCrossReference inst:CrossReference_05db9f1d4b8c,
        inst:CrossReference_252400a0c21d,
        inst:CrossReference_6355ebbd0a30,
        inst:CrossReference_663a503c89f2,
