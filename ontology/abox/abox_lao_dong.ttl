inst:Article_20_5_TT_3_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.3.3: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.3.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_04_2012_TT_BLDTBXH ;
    vlpd:contentText """1. Các Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Chủ tịch Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương chịu trách nhiệm thi hành các quy định tại Thông tư này.
2. Trong quá trình thực hiện, nếu có vướng mắc, các cơ quan, tổ chức, cá nhân phản ánh về Bộ Lao động- Thương và Xã hội để xem xét, giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_3_3_https_example_org_vn_legal_instance_Doc_Circular_04_2012_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

