inst:Article_20_5_LQ_71 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.LQ.71: Thực hiện công tác an toàn, vệ sinh lao động trong các cơ sở sản xuất, kinh doanh"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.LQ.71"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_71_https_example_org_vn_legal_instance_Doc_Law_84_2015_QH13 ;
    vlpd:contentText """1. Cơ sở sản xuất, kinh doanh khi tổ chức thực hiện công tác an toàn, vệ sinh lao động ngoài việc phải tuân thủ các quy định, về an toàn, vệ sinh lao động tại các chương I, II, III và IV của Luật này còn phải thực hiện các quy định tại Chương này.
2. Ban quản lý khu kinh tế, khu công nghiệp, khu chế xuất, khu công nghệ cao có trách nhiệm chỉ đạo tổ chức công tác an toàn, vệ sinh lao động đối với các cơ sở sản xuất, kinh doanh trong phạm vi quản lý; phối hợp tổ chức kiểm tra hoạt động về an toàn, vệ sinh lao động và báo cáo về hoạt động an toàn, vệ sinh lao động với cơ quan quản lý nhà nước về lao động trong phạm vi quản lý, trừ trường hợp pháp luật chuyên ngành có quy định khác.
3. Căn cứ vào quy mô, tính chất lao động, nguy cơ tai nạn lao động, bệnh nghề nghiệp, điều kiện lao động, Chính phủ quy định chi tiết việc áp dụng quy định về an toàn, vệ sinh lao động của Luật này đối với các cơ sở khác, ban quản lý khu kinh tế, khu công nghiệp, khu chế xuất, khu công nghệ cao quy định tại khoản 2 Điều này phù hợp với điều kiện lao động, tổ chức, bộ máy, chức năng, nhiệm vụ và các quy định khác của pháp luật chuyên ngành có liên quan."""@vi ;
    vlpd:hasCrossReference inst:CrossReference_dad876bf6747 ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_LQ_71_https_example_org_vn_legal_instance_Doc_Law_84_2015_QH13 ;
    vlpd:heading "Thực hiện công tác an toàn, vệ sinh lao động trong các cơ sở sản xuất, kinh doanh"@vi ;
    vlr:cites inst:Article_20_5_ND_1_35 .

