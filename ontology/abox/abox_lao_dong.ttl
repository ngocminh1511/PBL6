inst:Article_20_2_ND_6_6 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.2.NĐ.6.6: Thời gian làm việc để làm căn cứ tính chế độ"@vi ;
    vlpd:belongsToItem inst:Item_20_2 ;
    vlpd:codificationNumber "20.2.NĐ.6.6"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_6_https_example_org_vn_legal_instance_Doc_Decree_97_2022_ND_CP ;
    vlpd:contentText """1. Thời gian làm việc có đóng bảo hiểm xã hội làm căn cứ tính khoản tiền hỗ trợ quy định tại điểm c khoản 1 và điểm b khoản 2 Điều 3 Nghị định này là thời gian tính hưởng chế độ bảo hiểm xã hội bắt buộc theo quy định của pháp luật về bảo hiểm xã hội.
2. Thời gian làm việc để tính trợ cấp mất việc làm, trợ cấp thôi việc quy định tại điểm a khoản 4, điểm a khoản 5 Điều 3 và Điều 4 Nghị định này thực hiện theo quy định tại khoản 2 Điều 47, khoản 2 Điều 46 Bộ luật Lao động và khoản 3, khoản 4 Điều 8 Nghị định số 145/2020/NĐ-CP.
3. Thời gian làm việc để tính khoản tiền hỗ trợ quy định tại điểm b khoản 4 và điểm b khoản 5 Điều 3 Nghị định này là tổng thời gian người lao động đã làm việc thực tế tại doanh nghiệp thực hiện sắp xếp lại. Thời gian làm việc thực tế tại doanh nghiệp thực hiện sắp xếp lại thực hiện theo quy định tại điểm a khoản 3 và khoản 4 Điều 8 Nghị định số 145/2020/NĐ-CP.
4. Thời gian làm việc để tính khoản tiền hỗ trợ quy định tại điểm c khoản 1, điểm b khoản 2, điểm b khoản 4 và điểm b khoản 5 Điều 3 Nghị định này được tính theo năm (đủ 12 tháng), trường hợp có tháng lẻ thì từ đủ 01 tháng đến đủ 06 tháng được tính bằng 1/2 năm, trên 06 tháng được tính bằng 01 năm làm việc."""@vi ;
    vlpd:hasCrossReference inst:CrossReference_26d5a500f9c4,
        inst:CrossReference_3740dcd25018,
        inst:CrossReference_8eed4fd9be6a,
        inst:CrossReference_90de4c8217c4,
        inst:CrossReference_cbbb1c5e879e ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_2_ND_6_6_https_example_org_vn_legal_instance_Doc_Decree_97_2022_ND_CP ;
    vlpd:heading "Thời gian làm việc để làm căn cứ tính chế độ"@vi ;
