inst:Article_20_2_LQ_47 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.2.LQ.47: Trợ cấp mất việc làm"@vi ;
    vlpd:belongsToItem inst:Item_20_2 ;
    vlpd:codificationNumber "20.2.LQ.47"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_47_https_example_org_vn_legal_instance_Doc_Law_45_2019_QH14 ;
    vlpd:contentText """1. Người sử dụng lao động trả trợ cấp mất việc làm cho người lao động đã làm việc thường xuyên cho mình từ đủ 12 tháng trở lên mà bị mất việc làm theo quy định tại khoản 11 Điều 34 của Bộ luật này, cứ mỗi năm làm việc trả 01 tháng tiền lương nhưng ít nhất bằng 02 tháng tiền lương.
2. Thời gian làm việc để tính trợ cấp mất việc làm là tổng thời gian người lao động đã làm việc thực tế cho người sử dụng lao động trừ đi thời gian người lao động đã tham gia bảo hiểm thất nghiệp theo quy định của pháp luật về bảo hiểm thất nghiệp và thời gian làm việc đã được người sử dụng lao động chi trả trợ cấp thôi việc, trợ cấp mất việc làm.
3. Tiền lương để tính trợ cấp mất việc làm là tiền lương bình quân của 06 tháng liền kề theo hợp đồng lao động trước khi người lao động mất việc làm.
4. Chính phủ quy định chi tiết Điều này."""@vi ;
    vlpd:hasCrossReference inst:CrossReference_0f7c021a1c2d,
        inst:CrossReference_270b3916e12d,
        inst:CrossReference_4f8316bf4bfe,
        inst:CrossReference_7812bceeedbe,
        inst:CrossReference_94edd003833d,
        inst:CrossReference_955e132f6239,
        inst:CrossReference_c224dc83f2f6,
        inst:CrossReference_ea80d1254a17 ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_2_LQ_47_https_example_org_vn_legal_instance_Doc_Law_45_2019_QH14 ;
    vlpd:heading "Trợ cấp mất việc làm"@vi ;
