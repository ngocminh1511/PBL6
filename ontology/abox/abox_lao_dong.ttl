inst:Article_20_2_TT_3_7 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.2.TT.3.7: Nghỉ chuyển ca; Nghỉ hằng tuần; Nghỉ lễ, tết; Nghỉ hàng năm; Nghỉ việc riêng, nghỉ không hưởng lương"@vi ;
