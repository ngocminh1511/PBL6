inst:Article_20_2_ND_3_21 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.2.NĐ.3.21: Điều kiện cấp giấy phép"@vi ;
    vlpd:belongsToItem inst:Item_20_2 ;
    vlpd:codificationNumber "20.2.NĐ.3.21"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_21_https_example_org_vn_legal_instance_Doc_Decree_145_2020_ND_CP ;
    vlpd:contentText """1. Người đại diện theo pháp luật của doanh nghiệp thực hiện hoạt động cho thuê lại lao động phải bảo đảm điều kiện:
a) Là người quản lý doanh nghiệp theo quy định của Luật Doanh nghiệp;
b) Không có án tích;
c) Đã có thời gian trực tiếp làm chuyên môn hoặc quản lý về cho thuê lại lao động hoặc cung ứng lao động từ đủ 03 năm (36 tháng) trở lên trong thời hạn 05 năm liền kề trước khi đề nghị cấp giấy phép.
2. Doanh nghiệp đã thực hiện ký quỹ 2.000.000.000 đồng (hai tỷ đồng)."""@vi ;
    vlpd:hasCrossReference inst:CrossReference_30d3eb2f0549,
        inst:CrossReference_41e6e055e0e7,
        inst:CrossReference_b31ca9e51778,
        inst:CrossReference_c77fe9f778cf,
        inst:CrossReference_cdbf5f04a61a,
        inst:CrossReference_dcf57203a172 ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_2_ND_3_21_https_example_org_vn_legal_instance_Doc_Decree_145_2020_ND_CP ;
    vlpd:heading "Điều kiện cấp giấy phép"@vi ;
