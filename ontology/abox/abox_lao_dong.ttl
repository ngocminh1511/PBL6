inst:Article_20_5_TT_2_2 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.2.2: Hiệu lực thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.2.2"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_2_https_example_org_vn_legal_instance_Doc_Circular_02_2012_TT_BLDTBXH ;
    vlpd:contentText "Quy chuẩn kỹ thuật quốc gia An toàn lao động trong khai thác và chế biến đá có hiệu lực từ ngày 01 tháng 7 năm 2012"@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_2_2_https_example_org_vn_legal_instance_Doc_Circular_02_2012_TT_BLDTBXH ;
    vlpd:heading "Hiệu lực thi hành"@vi .

inst:Article_20_5_TT_2_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.2.3: Tổ chức thực hiện"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.2.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_02_2012_TT_BLDTBXH ;
    vlpd:contentText """1. Các Bộ, cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Chủ tịch Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương chịu trách nhiệm thi hành các quy định tại Thông tư này.
2. Trong quá trình thực hiện, nếu có vướng mắc, các cơ quan, tổ chức, cá nhân phản ánh về Bộ Lao động - Thương binh và Xã hội để xem xét, giải quyết."""@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_2_3_https_example_org_vn_legal_instance_Doc_Circular_02_2012_TT_BLDTBXH ;
    vlpd:heading "Tổ chức thực hiện"@vi .

