inst:Article_20_5_TT_24_3 a vlpd:CodificationArticle ;
    rdfs:label "Điều 20.5.TT.24.3: Trách nhiệm thi hành"@vi ;
    vlpd:belongsToItem inst:Item_20_5 ;
    vlpd:codificationNumber "20.5.TT.24.3"^^xsd:string ;
    vlpd:codificationOf inst:SourceArticle_3_https_example_org_vn_legal_instance_Doc_Circular_21_2016_TT_BYT ;
    vlpd:contentText "Cục trưởng Cục Quản lý môi trường y tế, Vụ trưởng, Cục trưởng, Tổng cục trưởng các Vụ, Cục, Tổng cục thuộc Bộ Y tế, Thủ trưởng các cơ quan, đơn vị trực thuộc Bộ, Giám đốc Sở Y tế các tỉnh, thành phố trực thuộc trung ương và Thủ trưởng cơ quan y tế các Bộ, ngành chịu trách nhiệm thi hành Thông tư này."@vi ;
    vlpd:hasSourceMapping inst:SourceMapping_https_example_org_vn_legal_instance_Article_20_5_TT_24_3_https_example_org_vn_legal_instance_Doc_Circular_21_2016_TT_BYT ;
    vlpd:heading "Trách nhiệm thi hành"@vi .

