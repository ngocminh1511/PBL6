inst:SourceClause_Law_45_2019_QH14_D46_K10 a vld:Clause ;
    vld:itemNumber "10"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceClause_Law_45_2019_QH14_D46_K2 a vld:Clause ;
    vld:contentText "2. Thời gian làm việc để tính trợ cấp thôi việc là tổng thời gian người lao động đã làm việc thực tê cho người sử dụng lao động trừ đi thời gian người lao động đã tham gia bảo hiểm thất nghiệp theo quy định của pháp luật về bảo hiểm thất nghiệp và thời gian làm việc đã được người sử dụng lao động chi trả trợ cấp thôi việc, trợ cấp mất việc làm."@vi ;
    vld:itemNumber "2"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceClause_Law_45_2019_QH14_D46_K3 a vld:Clause ;
    vld:contentText "3. Tiền lương để tính trợ cấp thôi việc là tiền lương bình quân của 06 tháng liên kê theo hợp đông lao động trước khi người lao động thôi việc"@vi ;
    vld:itemNumber "3"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceClause_Law_45_2019_QH14_D46_K4 a vld:Clause ;
    vld:contentText "4. Chính phủ quy định chi tiết điều này"@vi ;
    vld:itemNumber "4"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceClause_Law_45_2019_QH14_D46_K6 a vld:Clause ;
    vld:itemNumber "6"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

