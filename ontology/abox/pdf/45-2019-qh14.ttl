inst:SourceClause_Law_45_2019_QH14_D188_K2 a vld:Clause ;
    vld:contentText "2. Trong thời hạn 05 ngày làm việc kê từ ngày hòa giải viên lao động nhận được yêu cầu từ bên yêu cầu giải quyết tranh chấp hoặc từ cơ quan quy định tại khoản 3"@vi ;
    vld:itemNumber "2"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 ;
    vlr:citesComponent inst:SourceClause_Law_45_2019_QH14_D188_K3 .

