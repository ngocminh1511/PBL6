inst:SourceArticle_Law_45_2019_QH14_D197 a vld:Article ;
    rdfs:label "Điều 197. Giải quyết tranh chấp lao động tập thể về lợi ích của Hội đồng trọng tài lao động"@vi ;
    vld:hasClause inst:SourceClause_Law_45_2019_QH14_D197_K1,
        inst:SourceClause_Law_45_2019_QH14_D197_K2,
        inst:SourceClause_Law_45_2019_QH14_D197_K3,
