inst:SourceArticle_Law_45_2019_QH14_D28 a vld:Article ;
    rdfs:label "Điều 28. Thực hiện công việc theo hợp đồng lao động"@vi ;
    vld:heading "Thực hiện công việc theo hợp đồng lao động"@vi ;
    vld:itemNumber "28"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceArticle_Law_45_2019_QH14_D29 a vld:Article ;
    rdfs:label "Điều 29. Chuyển người lao động làm công việc khác so với hợp đồng lao động"@vi ;
