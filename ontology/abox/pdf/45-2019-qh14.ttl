    vld:itemNumber "2"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceClause_Law_45_2019_QH14_D73_K1 a vld:Clause ;
    vld:itemNumber "1"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceClause_Law_45_2019_QH14_D98_K1 a vld:Clause ;
    vld:contentText """1. Người lao động làm thêm giờ được trả lương tính theo đơn giá tiên lương hoặc tiền lương thực trả theo công việc đang làm như sau:
a) Vào ngày thường, ít nhất bằng 150%;
b) Vào ngày nghỉ hằng tuần, ít nhất bằng 200%;
c) Vào ngày nghi lễ, tết, ngày nghi có hưởng lương, ít nhất bằng 300% chưa kể tiền lương ngày lễ, tết, ngày nghi có hưởng lương đối với người lao động hưởng lương ngày"""@vi ;
    vld:itemNumber "1"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

inst:SourceClause_Law_45_2019_QH14_D98_K2 a vld:Clause ;
    vld:contentText "2. Người lao động làm việc vào ban đêm thì được trả thêm ít nhất bằng 30% tiền lương tính theo đơn giá tiền lương hoặc tiền lương thực trả theo công việc của ngày làm việc bình thường"@vi ;
    vld:itemNumber "2"^^xsd:string ;
    vld:locatedInDocument inst:Doc_Law_45_2019_QH14 .

