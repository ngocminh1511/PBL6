inst:Appendix_19-2016-tt-bldtbxh_8 a vld:Appendix ;
    vld:appendixIdentifier "19-2016-tt-bldtbxh:pl8"^^xsd:string ;
    vld:appendixKind "form"^^xsd:string ;
    vld:contentText """PHỤ LỤC 08
LỊCH TRÌNH TỔ CHỨC CÁC KỲ ĐÁNH GIÁ KỸ NĂNG NGHỀ QUỐC GIA TRONG NĂM (Ban hành kèm theo Thông tư số 19/2016/TT-BLĐTBXH ngày 28 tháng 6 năm 2016 của Bộ trưởng Bộ Lao động - Thương binh và Xã hội)
