    vld:heading "DANH SÁCH NGƯỜI THAM DỰ ĐẾN DỰ KIỂM TRA KIẾN THỨC, DỰ KIỂM TRA THỰC HÀNH (Ban hành kèm theo Thông tư số 19/2016/TT-BLĐTBXH ngày 28 tháng 6 năm 2016 của Bộ trưởng Bộ Lao động - Thương binh và Xã hội)"@vi ;
    vld:itemNumber "10"^^xsd:string ;
