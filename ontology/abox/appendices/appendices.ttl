inst:Appendix_54-2016-tt-bldtbxh_1 a vld:Appendix ;
    vld:appendixIdentifier "54-2016-tt-bldtbxh:pl1"^^xsd:string ;
    vld:appendixKind "form"^^xsd:string ;
    vld:contentText """Phụ lục 01
MẪU BẢN GHI CHÉP TẠI HIỆN TRƯỜNG (KIỂM ĐỊNH KỸ THUẬT AN TOÀN NỒI HƠI, NỒI ĐUN NƯỚC NÓNG)
(Tên tổ chức KĐ) -------
