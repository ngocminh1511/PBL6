# Copy this file to ".env" and fill in the values you need.
# .env is loaded automatically by generation/llm_client.py (python-dotenv).

# Which provider llm_client.py uses: "gemini" (default), "anthropic", or "openai"
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval backend (optional; defaults preserve the legacy pipeline) ---
# For the ontology v4 pilot use:
# QDRANT_COLLECTION=legal_v4_bkai
# DATASET_ID=an_toan_ve_sinh_lao_dong_v4
# EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
# NEO4J_DATABASE=neo4j
# QDRANT_URL=http://localhost:6333
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=labor_rag_pw
