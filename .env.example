# Copy this file to ".env" and fill in the values you need.
# .env is loaded automatically by generation/llm_client.py (python-dotenv).

# Which provider llm_client.py uses: "gemini" (default), "anthropic", or "openai"
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval backend (optional; defaults below = Lao dong, chunk schema v5) ---
# QDRANT_COLLECTION=legal_ld_v5_bge
# DATASET_ID=lao_dong_v5
# EMBEDDING_MODEL=BAAI/bge-m3
# NEO4J_DATABASE=neo4j
# Local docker (docker-compose.yml) is the default. For the cloud instead:
#   Qdrant Cloud:  QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333 + QDRANT_API_KEY
#   Neo4j AuraDB:  NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io + user/password from Aura
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=labor_rag_pw

# --- Where embed_and_index computes vectors: "local" (default) or "modal" ---
# "modal" needs `modal setup` + `modal deploy scripts/modal_embed.py` once.
# EMBEDDING_BACKEND=local

# --- OCR for user uploads (optional; labor_rag/ocr/settings.py) ---
# OCR_MODEL=vgg_transformer        # or vgg_seq2seq (faster, less accurate)
# OCR_DEVICE=                      # empty = cuda:0 if available, else cpu
# OCR_DPI=300
# OCR_BEAMSEARCH=0
# OCR_SEMANTIC_CHUNKING=0          # 1 = split long records with a sentence-embedding model
# OCR_SEMANTIC_MODEL=BAAI/bge-m3

#--HUGGING FACE--
# HF_TOKEN 