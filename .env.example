# Copy this file to ".env" and fill in the values you need.
# .env is loaded automatically by generation/llm_client.py (python-dotenv).

# Which provider llm_client.py uses: "gemini" (default), "anthropic", or "openai"
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval backend (optional; defaults below = Lao dong, chunk schema v5) ---
# QDRANT_COLLECTION=legal_ld_v5_bge
# DATASET_ID=lao_dong_v5
# EMBEDDING_MODEL=BAAI/bge-m3
# NEO4J_DATABASE=neo4j
# Local docker (docker-compose.yml) is the default. For the cloud instead:
#   Qdrant Cloud:  QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333 + QDRANT_API_KEY
#   Neo4j AuraDB:  NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io + user/password from Aura
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=labor_rag_pw

# --- Where embed_and_index computes vectors: "local" (default) or "modal" ---
# "modal" needs `modal setup` + `modal deploy scripts/modal_embed.py` once.
# EMBEDDING_BACKEND=local

# --- OCR for user uploads (optional; labor_rag/ocr/settings.py) ---
# OCR_MODEL=vgg_transformer        # or vgg_seq2seq (faster, less accurate)
# OCR_DEVICE=                      # empty = cuda:0 if available, else cpu
# OCR_DPI=300
# OCR_BEAMSEARCH=0
# OCR_SEMANTIC_CHUNKING=0          # 1 = split long records with a sentence-embedding model
# OCR_SEMANTIC_MODEL=BAAI/bge-m3

#--HUGGING FACE--
# HF_TOKEN

# --- Private Cloudflare R2, S3-compatible API ---
# Adding these values does not upload files. Run sync_r2 --upload explicitly.
# OBJECT_STORAGE_PROVIDER=s3
# OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=pbl6-legal-files
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_PREFIX=appendices_v1

# --- Unified application: cloud connections (never commit credentials) ---
# Public appendix/retrieval tools run without PostgreSQL, Redis or an LLM key.
DEMO_MODE=true
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lexgraph_db?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT/0
REDIS_ENABLED=true
# Required outside demo mode.
JWT_SECRET=
EMBEDDING_BACKEND=modal
QUERY_EMBEDDING_BACKEND=modal
MODAL_APP_NAME=labor-rag-embed
# Register only collections already indexed with the indicated model.
# COLLECTION_MODELS={"legal_ld_v5_bge":"BAAI/bge-m3"}
# Startup: environment/.env -> persisted admin overrides in PostgreSQL.
